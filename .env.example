# Copy this file to .env and fill in your values

# WebSocket server port (default: 8080)
PORT=8080

# Firebase service account JSON (base64-encoded) or path to JSON file
# Option 1: base64-encoded JSON string
FIREBASE_CREDENTIALS_BASE64=

# Option 2: absolute path to service account JSON file
FIREBASE_CREDENTIALS_PATH=

# Firebase project ID
FIREBASE_PROJECT_ID=

# Firebase database URL (only required when using Realtime Database)
FIREBASE_DATABASE_URL=
